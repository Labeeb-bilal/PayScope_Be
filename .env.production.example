# Production settings. Set these in your host's environment settings (Render/Railway/Fly dashboard),
# or copy this file to .env.production on a server (ignored by git). Real environment variables win over files.
NODE_ENV=production
# Port the server listens on inside the host. Render, Railway, Fly.io and Heroku set PORT automatically:
# leave this out there. Only set it on your own server/VM (users still visit plain https://, port 443).
# PORT=8080
# Where the SQLite file lives. Leave unset on a free host: it defaults to data/app.db inside the app folder
# (always writable; reset on restart). With a persistent disk, point it at the disk's mount path, e.g.:
# DB_PATH=/var/data/app.db
# true: if the database is empty at startup, insert the 10,000 demo employees. It never overwrites existing data.
# On a free host with an ephemeral disk this re-seeds on every restart. Set false once you hold real data.
SEED_IF_EMPTY=true

# Exact URL of the deployed frontend: origin only, no path or trailing slash. Comma-separate several.
# Leave unset if this API also serves the UI itself (same origin).
CORS_ORIGIN=https://your-frontend.example.com

# AI assistant (optional). Keep the key in the host's secret settings, never in git.
LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Only when this API also serves the built frontend (single deployable):
# STATIC_DIR=/app/frontend/out
