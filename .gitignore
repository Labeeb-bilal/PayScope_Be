# ── Credentials & secrets ─────────────────────────────
# Env files (any variant: .env, .env.local, .env.production, ...)
.env
.env.*
# Non-secret settings per environment are committed; secrets go in .env (ignored).
!.env.development
!.env.production.example

# Keys, certificates and credential files
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
*credentials*.json
service-account*.json
secrets.*
*.secret
.npmrc

# ── Dependencies ──────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────
dist/
*.tsbuildinfo

# ── Local SQLite database (re-created by `npm run seed` / auto-seed on boot)
data/*.db
data/*.db-*
*.sqlite
*.sqlite3

# ── Tests ─────────────────────────────────────────────
coverage/

# ── Logs ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / editor ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
