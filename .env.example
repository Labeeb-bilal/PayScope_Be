PORT=4000
DB_PATH=./data/app.db
SEED_IF_EMPTY=true
# STATIC_DIR=../frontend/out   # only needed when the API also serves the built UI

# ── AI assistant (optional) ─────────────────────────────
# Free key: https://console.groq.com/keys. Without it the assistant is disabled; the rest of the app works.
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint
# LLM_MODEL=openai/gpt-oss-120b             # must support tool calling
