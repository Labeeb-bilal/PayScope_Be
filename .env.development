# Development settings, loaded by `npm run dev`. Committed: NO SECRETS here.
# Secrets and personal overrides go in a file named .env next to this one (ignored by git, loaded after this
# file so its values win). For the AI assistant, create .env with:
#   LLM_API_KEY=gsk_your_key_here        (free key: https://console.groq.com/keys)
NODE_ENV=development
PORT=4000
DB_PATH=./data/app.db
SEED_IF_EMPTY=true
# The Next.js dev server (frontend `npm run dev`).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
